{
  "name": "oneplay",
  "version": "0.8.0",
  "private": true,
  "description": "A free cross-platform desktop media player powered by mpv and FFmpeg.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder --publish never",
    "build:dir": "npm run typecheck && vite build && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "me.oneplay.desktop",
    "productName": "OnePlay",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "vendor/mpv",
          "to": "mpv"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Kirtesh Admute <kirteshadmute@gmail.com>",
      "synopsis": "Free cross-platform media player"
    },
    "publish": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © Kirtesh Admute",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-x64-setup.${ext}"
    },
    "deb": {
      "depends": [
        "mpv"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portable.${ext}"
    }
  },
  "author": "Kirtesh Admute <kirteshadmute@gmail.com>"
}
