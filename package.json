{
  "name": "oneplay",
  "version": "0.1.0",
  "private": true,
  "description": "A free cross-platform desktop media player powered by mpv and FFmpeg.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:dir": "tsc -b && vite build && electron-builder --dir",
    "typecheck": "tsc -b --pretty",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "me.oneplay.desktop",
    "productName": "OnePlay",
    "asar": true,
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "release" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.video" },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo" }
  }
}
